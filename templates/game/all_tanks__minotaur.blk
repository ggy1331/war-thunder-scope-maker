    thousandth:b = yes;
  }
  line {
    line:p4 = 0, -0.5, 0, -3.5;
    thousandth:b = yes;
  }
}
drawCircles {
  circle {
    segment:p2 = 0, 360;
    pos:p2 = 0, 0;
    diameter:r = 80;
    size:r = 2.5;
    move:b = no;
    thousandth:b = yes;
  }
  circle {
    segment:p2 = 0, 360;
    pos:p2 = 0, 0;
    diameter:r = 0.100000001;
    size:r = 1.5;
    move:b = no;
    thousandth:b = yes;
  }
}
