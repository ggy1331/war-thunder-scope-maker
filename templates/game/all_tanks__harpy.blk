crosshairDistHorSizeAdditional:p2 = 0.00499999989, 0.00300000003;
distanceCorrectionPos:p2 = -0.100000001, 0.0299999993;
drawDistanceCorrection:b = yes;
drawSightMask:b = yes;
crosshairColor:c = 31, 239, 31, 255;
crosshairLightColor:c = 30, 30, 255, 255;
matchExpClass {
  sdi_harpy:b = yes;
}
ballistics {
  bullet {
    bulletType:t = "apds_fs_long_tank";
    speed:r = 2000;
    drawAdditionalLines:b = no;
    drawDistanceCorrection:b = yes;
    distanceCorrectionPos:p2 = -0.100000001, 0.100000001;
    distancePos:p2 = 0.109999999, 0;
    textAlign:i = 1;
    textPos:p2 = -0.0120000001, 0;
    textShift:r = 0;
    crosshairDistHorSizeMain:p2 = 0.00749999983, 0.00749999983;
    crosshairDistHorSizeAdditional:p2 = 0.00300000003, 0.00100000005;
    crosshair_distances {
      distance:p3 = 1, 0, 0;
      distance:p3 = 1000, 10, 0.00999999978;
      distance:p3 = 1500, 0, 0;
      distance:p3 = 2000, 20, 0.00999999978;
      distance:p3 = 2500, 0, 0;
      distance:p3 = 3000, 30, 0.00999999978;
      distance:p3 = 4000, 0, 0.00999999978;
    }
  }
  bullet {
    bulletType:t = "sap_hei_tank";
    speed:r = 1400;
    drawAdditionalLines:b = no;
    drawDistanceCorrection:b = no;
    distanceCorrectionPos:p2 = -0.0900000036, -0.0500000007;
    distancePos:p2 = -0.101999998, 0;
    textPos:p2 = 0.0199999996, 0;
    textShift:r = 0;
    textAlign:i = 2;
    crosshairDistHorSizeMain:p2 = 0.00749999983, 0.00749999983;
    crosshairDistHorSizeAdditional:p2 = 0.00499999989, 0.00300000003;
    crosshair_distances {
      distance:p3 = 1, 0, 0;
      distance:p3 = 500, 5, -0.00999999978;
      distance:p3 = 1000, 10, -0.00999999978;
      distance:p3 = 1500, 15, -0.00999999978;
      distance:p3 = 2000, 20, 0;
      distance:p3 = 2500, 25, -0.00999999978;
      distance:p3 = 3000, 30, 0;
    }
  }
}
