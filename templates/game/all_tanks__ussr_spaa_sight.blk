fontSizeMult:r = 1;
lineSizeMult:r = 1.5;
drawCentralLineVert:b = no;
drawCentralLineHorz:b = no;
crosshairDistHorSizeMain:p2 = 0.0299999993, 0.0199999996;
crosshairDistHorSizeAdditional:p2 = 0.00499999989, 0.00300000003;
distanceCorrectionPos:p2 = -0.200000003, -0.0500000007;
drawDistanceCorrection:b = yes;
crosshairColor:c = 0, 165, 255, 255;
crosshairLightColor:c = 255, 255, 255, 200;
matchExpClass {
  exp_heavy_tank:b = yes;
  exp_tank:b = yes;
  exp_tank_destroyer:b = yes;
  exp_SPAA:b = yes;
}
