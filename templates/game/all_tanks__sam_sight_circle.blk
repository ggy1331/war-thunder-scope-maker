// Extracted from local War Thunder config/tanksights.blk; game 2.59.0.86
crosshairHorVertSize:p2 = 3, 2;
rangefinderProgressBarColor1:c = 0, 255, 0, 64;
rangefinderProgressBarColor2:c = 255, 255, 255, 64;
rangefinderTextScale:r = 0.699999988;
rangefinderUseThousandth:b = no;
rangefinderVerticalOffset:r = 0.100000001;
rangefinderHorizontalOffset:r = 99999;
detectAllyTextScale:r = 0.699999988;
detectAllyOffset:p2 = 4, 0.0500000007;
fontSizeMult:r = 1.5;
lineSizeMult:r = 1.70000005;
drawCentralLineVert:b = no;
drawCentralLineHorz:b = no;
drawSightMask:b = yes;
useSmoothEdge:b = yes;
crosshairColor:c = 255, 255, 255, 255;
crosshairLightColor:c = 255, 255, 255, 255;
crosshairDistHorSizeMain:p2 = 0.0299999993, 0.0199999996;
crosshairDistHorSizeAdditional:p2 = 0.00499999989, 0.00300000003;
distanceCorrectionPos:p2 = -0.25999999, -0.0500000007;
drawDistanceCorrection:b = yes;
matchExpClass {
  exp_heavy_tank:b = yes;
  exp_tank:b = yes;
  exp_tank_destroyer:b = yes;
  exp_SPAA:b = yes;
}
crosshair_distances {
}
crosshair_hor_ranges {
}
drawLines {
  line {
    line:p4 = 0, 0, 1.5, 2.5;
    thousandth:b = yes;
    move:b = no;
  }
  line {
    line:p4 = 0, 0, -1.5, 2.5;
    thousandth:b = yes;
    move:b = no;
  }
}
drawCircles {
  circle {
    segment:p2 = 0, 360;
    pos:p2 = 0, 0;
    diameter:r = 56.25;
    size:r = 2;
    move:b = no;
    thousandth:b = yes;
  }
}
