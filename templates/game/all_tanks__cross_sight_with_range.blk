// Extracted from local War Thunder config/tanksights.blk; game 2.59.0.86
crosshairHorVertSize:p2 = 3, 2;
rangefinderProgressBarColor1:c = 0, 255, 0, 64;
rangefinderProgressBarColor2:c = 255, 255, 255, 64;
rangefinderTextScale:r = 0.600000024;
rangefinderUseThousandth:b = yes;
rangefinderVerticalOffset:r = 100;
rangefinderHorizontalOffset:r = -50;
detectAllyTextScale:r = 0.699999988;
detectAllyOffset:p2 = 4, 0.0500000007;
fontSizeMult:r = 1.70000005;
lineSizeMult:r = 2;
drawCentralLineVert:b = no;
drawCentralLineHorz:b = no;
drawSightMask:b = yes;
useSmoothEdge:b = yes;
crosshairColor:c = 0, 0, 0, 0;
crosshairLightColor:c = 0, 0, 255, 200;
crosshairDistHorSizeMain:p2 = 0.0299999993, 0.0199999996;
crosshairDistHorSizeAdditional:p2 = 0.00499999989, 0.00300000003;
distanceCorrectionPos:p2 = 0.150000006, -0.204999998;
drawDistanceCorrection:b = yes;
applyCorrectionToGun:b = yes;
matchExpClass {
  exp_heavy_tank:b = yes;
  exp_tank:b = yes;
  exp_tank_destroyer:b = yes;
  exp_SPAA:b = yes;
}
crosshair_distances {
  distance:p3 = 400, 0, 0;
  distance:p3 = 800, 8, 0;
  distance:p3 = 1200, 0, 0;
  distance:p3 = 1600, 16, 0;
  distance:p3 = 2000, 0, 0;
  distance:p3 = 2400, 24, 0;
  distance:p3 = 2800, 0, 0;
  distance:p3 = 3200, 32, 0;
  distance:p3 = 3600, 0, 0;
  distance:p3 = 4000, 40, 0;
  distance:p3 = 4400, 0, 0;
  distance:p3 = 4800, 48, 0;
  distance:p3 = 5200, 0, 0;
  distance:p3 = 5600, 56, 0;
  distance:p3 = 6000, 0, 0;
}
crosshair_hor_ranges {
}
drawLines {
  line {
    line:p4 = 0.699999988, 0, 120, 0;
    move:b = no;
    thousandth:b = yes;
  }
  line {
    line:p4 = -0.699999988, 0, -120, 0;
    move:b = no;
    thousandth:b = yes;
  }
  line {
    line:p4 = 0, 0.699999988, 0, 120;
    move:b = no;
    thousandth:b = yes;
  }
  line {
    line:p4 = 0, -0.699999988, 0, -120;
    move:b = no;
    thousandth:b = yes;
  }
}
